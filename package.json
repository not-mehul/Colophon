{
  "name": "colophon",
  "version": "1.0.3",
  "private": true,
  "description": "Colophon — an edition inspector, imprint editor and bindery for EPUB files, in one HTML file.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && dusk-dawn colours --skip \"^icons\\.ts$\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test",
    "check": "dusk-dawn check && npm run lint && npm run typecheck && npm test",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "dusk-dawn": "file:vendor/dusk-dawn",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lucide-static": "1.68.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "Mehul Sen"
}
